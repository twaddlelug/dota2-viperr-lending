{
  "name": "dota2-viperr-lending",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "prisma generate && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "prisma generate && react-router typegen && tsc",
    "lint": "biome check .",
    "test": "vitest run",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm knip",
    "db:dev": "prisma dev --name viperr --detach",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "isbot": "^5.1.31",
    "lucide-react": "^1.50.0",
    "ogl": "^1.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^8.4.0",
    "simple-icons": "^16.33.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "knip": "^6.39.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  }
}
