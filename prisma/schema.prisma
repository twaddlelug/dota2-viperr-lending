generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(cuid())
  discordId  String  @unique
  username   String
  globalName String?
  avatarUrl  String?

  steamId         String? @unique
  steamName       String?
  steamAvatarUrl  String?
  steamProfileUrl String?

  player    Player?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Server {
  id               String   @id @default(cuid())
  name             String
  iconUrl          String?
  inviteUrl        String?
  managerDiscordId String?
  team             Team?
  createdAt        DateTime @default(now())

  @@index([managerDiscordId])
}

model Team {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tag       String
  logoUrl   String?
  serverId  String   @unique
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Restrict)
  seed      Int?     @unique
  players   Player[]
  createdAt DateTime @default(now())
}

model Player {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nickname  String
  position  Int?
  isCaptain Boolean @default(false)

  userId     String? @unique
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  inviteCode String? @unique

  createdAt DateTime @default(now())

  @@unique([teamId, position])
}

model Settings {
  id              Int      @id @default(1)
  heroText        String?
  aboutTitle      String?
  aboutText       String?
  discordEventUrl String?
  updatedAt       DateTime @updatedAt
}

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
}

model Match {
  id        String      @id
  scoreA    Int?
  scoreB    Int?
  status    MatchStatus @default(UPCOMING)
  startsAt  DateTime?
  updatedAt DateTime    @updatedAt
}
